# Chave de assinatura dos tokens JWT. Troque por um valor longo e aleatório em produção.
JWT_SECRET=troque-esta-chave-em-producao

# Validade do token emitido no login (formato aceito pelo jsonwebtoken).
JWT_EXPIRES_IN=1h

# Work factor do BCrypt. Mínimo aceito pela aplicação: 8.
BCRYPT_SALT_ROUNDS=10
